# Local MongoDB. The selected database follows APP_ENV unless MONGODB_DATABASE is set.
APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/gaurav-sales-dev
# Optional explicit database override:
# MONGODB_DATABASE=gaurav-sales-dev

# Alternatively, use Atlas locally or on Vercel with a private connection string.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/

ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters

# Gmail SMTP uses a Google App Password (not your regular Gmail password).
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# Vercel Blob supplies this when its store is connected to the project.
# BLOB_READ_WRITE_TOKEN=